# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── DATABASE (MongoDB) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/church_cms?retryWrites=true&w=majority

# ─── DATABASE (PostgreSQL - Legacy) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/church_cms

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── CMS ROOT CREDENTIALS ────────────────────────────────────────────────────
CMS_EMAIL=cms@church.org
CMS_PASSWORD=cms123

# ─── EMAIL (Nodemailer / Brevo SMTP) ─────────────────────────────────────────
# Option A: Brevo (recommended for Nigeria)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@email.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourchurch.org
EMAIL_FROM_NAME=Your Church Name

# Option B: Gmail (for testing only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password

# ─── TWILIO (WhatsApp + SMS) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# WhatsApp (Twilio WhatsApp sandbox or approved sender)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS — use Twilio number OR Termii for Nigerian SMS
TWILIO_SMS_FROM=+1234567890

# ─── TERMII (Nigerian SMS - cheaper alternative) ─────────────────────────────
# Uncomment to use Termii instead of Twilio for SMS
# TERMII_API_KEY=your_termii_api_key
# TERMII_SENDER_ID=YourChurch
# SMS_PROVIDER=termii   # set to "twilio" or "termii"
SMS_PROVIDER=twilio

# ─── CHURCH INFO (used in message templates) ──────────────────────────────────
CHURCH_NAME=Citadel of Truth and Mercy
CHURCH_ADDRESS=123 Faith Avenue, Lagos
CHURCH_PHONE=+2348012345678
CHURCH_WEBSITE=https://yourchurch.org
SUNDAY_SERVICE_TIME=9:00 AM
WEDNESDAY_SERVICE_TIME=6:00 PM
